+def question_batch_sizes(lengths, limit):
+    """Keep row order, group count and the row limit; minimize padded question positions."""
+    count = len(lengths)
+    full, tail = divmod(count, limit)
+    if not tail or not full:
+        return (limit,) * full + ((tail,) if tail else ())
+
+    @lru_cache(maxsize=None)
+    def partition(start, groups):
+        remaining = count - start
+        if groups == 1:
+            return remaining * max(lengths[start:]), (remaining,)
+        smallest = max(1, remaining - (groups - 1) * limit)
+        largest = min(limit, remaining - (groups - 1))
+        best_cost, best_sizes = float("inf"), ()
+        for size in range(largest, smallest - 1, -1):
+            stop = start + size
+            rest_cost, rest_sizes = partition(stop, groups - 1)
+            cost = size * max(lengths[start:stop]) + rest_cost
+            if cost < best_cost:
+                best_cost, best_sizes = cost, (size,) + rest_sizes
+        return best_cost, best_sizes
+
+    return partition(0, full + 1)[1]
+
