+def export_mali_input(capture_path, output):
+    """Write the real question queries and common keys in CLBlast's head-major FP32 layout."""
+    data = torch.load(capture_path, map_location="cpu", weights_only=True)
+    q, k = data["q"], data["k"]
+    batch, heads, length, dim = q.shape
+    shared, kv_heads, keys, key_dim = k.shape
+    if shared != 1 or dim != key_dim or heads % kv_heads:
+        raise ValueError("expected grouped queries over one shared segment")
+    groups = heads // kv_heads
+    q = q.reshape(batch, kv_heads, groups, length, dim).permute(1, 0, 2, 3, 4)
+    with output.open("wb") as f:
+        f.write(struct.pack("<4If", kv_heads, batch * groups * length, keys, dim, data["scale"]))
+        for t in (q, k):
+            t.float().contiguous().numpy().astype("<f4", copy=False).tofile(f)


